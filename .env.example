# DART 오픈API 키 (https://opendart.fss.or.kr 에서 발급)
DART_API_KEY=

# 비어 있으면 LLM 요약 단계를 건너뛰고 픽스처/템플릿 문장을 씁니다
ANTHROPIC_API_KEY=

# 출력 폴더, DB 파일
GONGSI_OUT_DIR=out
GONGSI_DB_PATH=out/gongsi.sqlite

# 이미지 제공자 우선순위. 예: pixabay,openverse,none  (none = 코드 벡터 일러스트, 항상 마지막 폴백)
# pixabay: 가입 후 https://pixabay.com/api/docs/ 에 키 표시 / openverse: 키 불필요(CC, 출처 표기) / pexels / gemini / openai
IMAGE_PROVIDER=none
PIXABAY_API_KEY=
PEXELS_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# ---- 게시 (python -m gongsi.publish) ----
# 이미지 호스팅 = 이 저장소(public). Actions에서는 GITHUB_REPOSITORY가 자동, 로컬에서만 채움
GONGSI_REPO=owner/repo
POSTS_BRANCH=main
# 텔레그램 승인 봇 (@BotFather 로 생성, chat_id 는 봇에 말 건 뒤 getUpdates 로 확인)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# telegram = 버튼 승인 후 게시 / auto = 검증 통과하면 바로 게시
APPROVAL=telegram
# 인스타그램 (Instagram API with Instagram Login). 프로페셔널 계정 + Meta 개발자 앱 'Instagram' 제품
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_GRAPH_HOST=graph.instagram.com
IG_API_VERSION=v23.0
